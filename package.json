{
  "name": "streetview-takengon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "tsx --env-file=.env watch apps/api/src/index.ts",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "migrate": "node scripts/migrate.js",
    "seed": "npx tsx db/seed/seed.ts",
    "reconvert": "node scripts/reconvert-flat-photos.mjs"
  },
  "allowScripts": {
    "argon2@0.31.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true
  }
}
